# Copy this file to .env.local and fill in real values.
# Get these from Supabase project settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://kdyxeqynlreydzhqffhm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key is only used server-side (never exposed to the browser).
# Needed for admin write operations that should bypass RLS, e.g. publishing.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
